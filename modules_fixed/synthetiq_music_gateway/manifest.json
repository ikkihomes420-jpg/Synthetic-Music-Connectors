{
  "id": "synthetiq-music-gateway-v1",
  "name": "Synthetiq Music Gateway",
  "description": "Unified music search and playback with low-latency progressive search, predictive audio prefetch, cache-first home shelves, resilient streaming, radio, albums, lyrics, artists, playlists, charts, and taste recommendations.",
  "type": "client",
  "contentType": "music",
  "contractVersion": 4,
  "formatVersion": 3,
  "moduleVersion": "1.10.1",
  "moduleFamilyId": "synthetiq_music_gateway",
  "moduleIdentity": "SP-MUS-3006-MUSIC-GATEWAY",
  "moduleIdentityNumber": 3006,
  "releaseTrack": "production",
  "baseUrl": "https://music.youtube.com",
  "config": {
    "capabilities": {
      "music_home_v1": true,
      "local_listening_stats_v1": true,
      "search_filters_v1": true,
      "search_pagination_v1": true,
      "album_view_v1": true,
      "playlist_view_v1": true,
      "artist_profiles_v1": true,
      "lyrics_v1": true,
      "radio_v1": true,
      "real_charts_v1": true,
      "taste_recommendations_v1": true,
      "offline_download_v1": true,
      "release_radar_v1": true
    },
    "runtime": {
      "mode": "local",
      "entry": "fast.js"
    },
    "caps": {
      "homeMaxResults": 48,
      "maxResponseBytes": 524288,
      "timeoutMs": 3500,
      "maxConcurrentRequests": 6,
      "searchPaginationPages": 3,
      "cacheStrategy": "stale-while-revalidate-lru"
    },
    "playbackMode": "full",
    "allowOfflineDownload": true
  },
  "moduleStatus": "production"
}
