{
  "id": "freefy-music-v1",
  "name": "Freefy Music",
  "description": "Resilient worldwide music search and playback via YouTube Music with Invidious/Piped/ListenFree failover, health-checked mirrors, and TTL caching.",
  "type": "client",
  "contentType": "music",
  "contractVersion": 4,
  "formatVersion": 3,
  "moduleVersion": "2.0.0",
  "moduleFamilyId": "freefy_music",
  "moduleIdentity": "SP-MUS-3010-FREEFY",
  "moduleIdentityNumber": 3010,
  "releaseTrack": "production",
  "baseUrl": "https://music.youtube.com",
  "config": {
    "capabilities": {
      "music_home_v1": true,
      "local_listening_stats_v1": true,
      "search_filters_v1": true,
      "artist_profiles_v1": true,
      "album_view_v1": true,
      "playlist_view_v1": true,
      "lyrics_v1": true,
      "queue_management_v1": true,
      "offline_download_v1": true,
      "recommendations_v1": true
    },
    "runtime": {
      "mode": "local",
      "entry": "index.js"
    },
    "caps": {
      "homeMaxResults": 24,
      "maxResponseBytes": 524288,
      "timeoutMs": 8000,
      "maxConcurrentRequests": 4,
      "audioQualityLevels": [
        "128",
        "192",
        "256",
        "320"
      ],
      "cacheTtls": {
        "searchMs": 300000,
        "metadataMs": 3600000,
        "audioUrlMs": 180000
      }
    },
    "playbackMode": "full",
    "allowOfflineDownload": true
  },
  "moduleStatus": "production"
}