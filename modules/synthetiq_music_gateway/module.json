{
  "id": "synthetiq-music-gateway-v1",
  "name": "Synthetiq Music Gateway",
  "description": "Unified music connector: YouTube Music full catalog with resilient streaming (mirror failover pools), real radio recommendations, artist pages, albums, playlists, lyrics, genre charts, and search filters; ListenFree/JioSaavn fallbacks.",
  "type": "client",
  "contentType": "music",
  "contractVersion": 4,
  "formatVersion": 3,
  "moduleVersion": "1.6.0",
  "moduleFamilyId": "synthetiq_music_gateway",
  "moduleIdentity": "SP-MUS-3006-MUSIC-GATEWAY",
  "moduleIdentityNumber": 3006,
  "releaseTrack": "staging",
  "baseUrl": "https://music.youtube.com",
  "config": {
    "capabilities": {
      "music_home_v1": true,
      "local_listening_stats_v1": true,
      "search_filters_v1": true,
      "album_view_v1": true,
      "playlist_view_v1": true,
      "artist_profiles_v1": true,
      "lyrics_v1": true,
      "radio_v1": true,
      "genre_charts_v1": true,
      "offline_download_v1": true
    },
    "runtime": {
      "mode": "local",
      "entry": "index.js"
    },
    "caps": {
      "homeMaxResults": 24,
      "maxResponseBytes": 524288,
      "timeoutMs": 10000,
      "maxConcurrentRequests": 4
    },
    "playbackMode": "full",
    "allowOfflineDownload": true
  },
  "moduleStatus": "staging"
}